<Window x:Class="PolarWare.Checker.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PolarWare Checker" Width="900" Height="620" WindowStyle="None"
 ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#101010"
 Foreground="White" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#171717"/>
   <Setter Property="BorderBrush" Value="#656565"/>
   <Setter Property="Padding" Value="14,6"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="Underline" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="#101010" Padding="18,11">
       <ContentPresenter ContentSource="Header"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="White"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="Background" Value="#333333"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <DataTemplate x:Key="DiagnosticRow">
   <Border BorderBrush="#353535" BorderThickness="0,0,0,1" Height="41">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
     <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="#C1C1C1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
     <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontFamily="Consolas"/>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="Shell" Width="900" Height="620">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
  <Border BorderBrush="#353535" BorderThickness="0,0,0,1">
   <Grid Margin="22,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="Transparent" MouseLeftButtonDown="DragTitle">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="Assets/polar.png" Width="28" Height="28" Margin="0,0,12,0"/>
      <TextBlock Text="POLARWARE CHECKER" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="−" AutomationProperties.Name="Minimize" Click="MinimizeWindow" Margin="0,0,8,0"/>
     <Button Content="×" AutomationProperties.Name="Close" Click="CloseWindow"/>
    </StackPanel>
   </Grid>
  </Border>
  <TabControl Grid.Row="1" Background="#101010" Foreground="White" BorderThickness="0" Padding="0" Margin="22,4">
   <TabItem Header="System"><ItemsControl x:Name="SystemRows" Margin="0,14" ItemTemplate="{StaticResource DiagnosticRow}"/></TabItem>
   <TabItem Header="HWID">
    <StackPanel Margin="0,24">
     <TextBlock Text="Hardware UUID" FontSize="26" FontWeight="Bold"/>
     <TextBlock x:Name="HardwareValue" Text="Reading…" FontFamily="Consolas" FontSize="21" Margin="0,16"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="Windows"><StackPanel Margin="0,14">
    <ItemsControl x:Name="WindowsRows" ItemTemplate="{StaticResource DiagnosticRow}"/>
    <Button Content="Open Windows Security" Click="OpenSecurity" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></TabItem>
   <TabItem Header="Boosters"><StackPanel Margin="0,14">
    <ItemsControl x:Name="BoosterRows" ItemTemplate="{StaticResource DiagnosticRow}"/>
    <Button Content="Installed apps" Click="OpenApps" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></TabItem>
   <TabItem Header="Anti-cheats"><ItemsControl x:Name="AnticheatRows" Margin="0,14" ItemTemplate="{StaticResource DiagnosticRow}"/></TabItem>
   <TabItem Header="Needed">
    <StackPanel Margin="0,15">
     <TextBlock Text="Required runtimes" FontSize="29" FontWeight="Bold" Margin="0,0,0,12"/>
     <Grid Height="34" TextBlock.FontWeight="SemiBold">
      <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
      <TextBlock Text="Component"/><TextBlock Grid.Column="1" Text="Installed version"/><TextBlock Grid.Column="2" Text="Status"/><TextBlock Grid.Column="3" Text="Action"/>
     </Grid>
     <ItemsControl x:Name="RuntimeRows">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#353535" BorderThickness="0,1,0,0" Height="48">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#C1C1C1"/>
         <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"/>
         <Button Grid.Column="3" Content="{Binding Action}" Click="RunPackage" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
           <Style.Triggers>
            <DataTrigger Binding="{Binding Action}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="Install"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/></DataTrigger>
           </Style.Triggers>
          </Style></Button.Style>
         </Button>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="#353535" BorderThickness="0,1,0,0" Padding="22,6">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="True">
     <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="RefreshClicked" Margin="8,0,0,0"/>
     <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" Click="CopyUuid" IsEnabled="False"/>
     <TextBlock x:Name="FooterUuid" Text="Hardware UUID · Reading…" VerticalAlignment="Center" FontFamily="Consolas"/>
    </DockPanel>
    <TextBlock Grid.Row="1" x:Name="Message" Foreground="#C1C1C1" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
  </Border>
 </Grid>
</Window>
