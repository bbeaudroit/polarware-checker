<Window
    x:Class="PolarWare.Checker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PolarWare Checker"
    Width="500" Height="560"
    Background="{StaticResource BgBrush}"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    WindowStyle="None"
    AllowsTransparency="True">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0F15" Offset="0"/>
                <GradientStop Color="#0E1420" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnTitleBarDrag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Width="28" Height="24" Padding="0" Margin="0,8,8,0"
                        BorderThickness="0" Background="Transparent"
                        Foreground="{StaticResource MutedBrush}" FontSize="13" Cursor="Hand"
                        Click="OnMinimize" Content="—"/>
                <Button Grid.Column="1" Width="28" Height="24" Padding="0" Margin="0,8,40,0"
                        BorderThickness="0" Background="Transparent"
                        Foreground="{StaticResource MutedBrush}" FontSize="12" Cursor="Hand"
                        Click="OnClose" Content="✕" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Logo -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
                <Ellipse Width="18" Height="18" Fill="{StaticResource PolarBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#60A5FA" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="PolarWare" Foreground="{StaticResource FgBrush}"
                           FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Checks list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontFamily="Consolas"
                               HorizontalAlignment="Center" Margin="0,0,0,12"
                               Text="running…"/>
                    <ItemsControl x:Name="ChecksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" CornerRadius="10" Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="20" CornerRadius="999"
                                                Margin="0,2,10,0" Background="{Binding StateBrush}">
                                            <TextBlock Text="{Binding StateLabel}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#0B0F15"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource FgBrush}"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Fix}" Foreground="{StaticResource PolarBrush}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Visibility="{Binding FixVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: icons + rerun -->
            <Grid Grid.Row="3" Margin="24,12,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Web -->
                    <Button Width="32" Height="32" Padding="0" BorderThickness="0"
                            Background="Transparent" Cursor="Hand" Margin="0,0,6,0"
                            Click="OnOpenWeb" ToolTip="polarware.vercel.app">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#121824" CornerRadius="8" Padding="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Stroke="#60A5FA" StrokeThickness="1.6" Fill="Transparent"
                              Data="M 10 1 A 9 9 0 1 1 9.99 1 M 1 10 L 19 10 M 10 1 C 6 5 6 15 10 19 M 10 1 C 14 5 14 15 10 19"/>
                    </Button>
                    <!-- Discord -->
                    <Button Width="32" Height="32" Padding="0" BorderThickness="0"
                            Background="Transparent" Cursor="Hand" Margin="0,0,6,0"
                            Click="OnOpenDiscord" ToolTip="Discord">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#121824" CornerRadius="8" Padding="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Fill="#60A5FA"
                              Data="M 20.317 4.3698 C 18.787 3.6784 17.147 3.1685 15.432 2.8777 C 15.401 2.8721 15.370 2.886 15.355 2.9139 C 15.144 3.2841 14.911 3.767 14.748 4.1465 C 12.904 3.8711 11.069 3.8711 9.263 4.1465 C 9.100 3.7585 8.858 3.2841 8.646 2.9139 C 8.631 2.8870 8.600 2.8731 8.569 2.8777 C 6.856 3.1676 5.215 3.6774 3.684 4.3698 C 3.671 4.3754 3.660 4.3847 3.653 4.3968 C 0.533 9.0462 -0.319 13.579 0.099 18.055 C 0.101 18.077 0.113 18.098 0.130 18.111 C 2.183 19.618 4.172 20.533 6.123 21.140 C 6.155 21.149 6.188 21.138 6.208 21.112 C 6.671 20.482 7.082 19.818 7.436 19.120 C 7.456 19.080 7.437 19.032 7.396 19.016 C 6.744 18.770 6.124 18.471 5.527 18.131 C 5.481 18.105 5.477 18.040 5.519 18.009 C 5.645 17.916 5.770 17.819 5.891 17.721 C 5.912 17.704 5.942 17.700 5.966 17.710 C 9.889 19.500 14.137 19.500 18.013 17.710 C 18.038 17.699 18.067 17.703 18.090 17.720 C 18.210 17.818 18.336 17.916 18.462 18.009 C 18.504 18.040 18.501 18.105 18.455 18.131 C 17.858 18.477 17.238 18.770 16.585 19.015 C 16.544 19.031 16.527 19.080 16.546 19.120 C 16.908 19.817 17.319 20.481 17.773 21.111 C 17.793 21.138 17.826 21.149 17.859 21.140 C 19.819 20.533 21.808 19.618 23.861 18.111 C 23.878 18.098 23.890 18.078 23.892 18.056 C 24.392 12.884 23.054 8.388 20.348 4.3978 C 20.342 4.3847 20.330 4.3754 20.317 4.3698 Z M 8.020 15.329 C 6.838 15.329 5.863 14.244 5.863 12.911 C 5.863 11.579 6.819 10.494 8.020 10.494 C 9.230 10.494 10.198 11.589 10.179 12.911 C 10.179 14.244 9.221 15.329 8.020 15.329 Z M 15.995 15.329 C 14.812 15.329 13.838 14.244 13.838 12.911 C 13.838 11.579 14.794 10.494 15.995 10.494 C 17.206 10.494 18.173 11.589 18.154 12.911 C 18.154 14.244 17.206 15.329 15.995 15.329 Z"/>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" x:Name="RunBtn" Content="Re-run" Click="OnRun"
                        Padding="18,8" FontSize="12" FontWeight="SemiBold" BorderThickness="0"
                        Foreground="#0B0F15" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="999" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#60A5FA" Offset="0"/>
                                        <GradientStop Color="#93C5FD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
