<Application
    x:Class="PolarWare.Checker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush"     Color="#0B0F15"/>
        <SolidColorBrush x:Key="CardBrush"   Color="#121824"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1E2839"/>
        <SolidColorBrush x:Key="FgBrush"     Color="#E6EAF2"/>
        <SolidColorBrush x:Key="MutedBrush"  Color="#8A95A8"/>
        <SolidColorBrush x:Key="PolarBrush"  Color="#60A5FA"/>
        <SolidColorBrush x:Key="PassBrush"   Color="#22C55E"/>
        <SolidColorBrush x:Key="WarnBrush"   Color="#F59E0B"/>
        <SolidColorBrush x:Key="FailBrush"   Color="#EF4444"/>
    </Application.Resources>
</Application>
